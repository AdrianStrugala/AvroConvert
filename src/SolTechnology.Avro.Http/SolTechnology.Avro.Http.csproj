<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Authors>Adrian Strugala</Authors>
    <Company>SolTechnology</Company>
    <Version>4.0.0-preview.3</Version>
    <Description>Apache Avro over HTTP with AvroConvert: HttpClient extensions, MVC formatters, Minimal API results and request bodies, and streaming of IAsyncEnumerable in both directions.</Description>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageProjectUrl>https://soltechnology.dev/avroconvert/</PackageProjectUrl>
    <RepositoryType>Dependency</RepositoryType>
    <PackageTags>avro communication http net core microservice apache.avro avro avroConvert </PackageTags>
    <ApplicationIcon />
    <PackageId>SolTechnology.Avro.Http</PackageId>
    <RepositoryUrl>https://github.com/AdrianStrugala/AvroConvert</RepositoryUrl>
    <AssemblyName>SolTechnology.Avro.Http</AssemblyName>
    <RootNamespace>SolTechnology.Avro.Http</RootNamespace>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageIcon>avroconvert-icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\avroconvert-icon.png" Pack="true" Visible="false" PackagePath="\" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\licenses\PolyForm-Noncommercial-1.0.0.md" Pack="true" PackagePath="licenses\" />
    <None Include="..\..\licenses\PolyForm-Small-Business-1.0.0.md" Pack="true" PackagePath="licenses\" />
    <None Include="..\..\licenses\Commercial.md" Pack="true" PackagePath="licenses\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvroConvert\AvroConvert.csproj" />
  </ItemGroup>

</Project>

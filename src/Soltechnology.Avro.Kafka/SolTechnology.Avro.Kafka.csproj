<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Authors>Adrian Strugala</Authors>
		<Company>SolTechnology</Company>
		<Version>4.0.0-preview.1</Version>
		<Description>AvroConvert serializers for Confluent Kafka: plain .NET objects in the Confluent Schema Registry wire format, interoperable with the Confluent serializers of any language.</Description>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageProjectUrl>https://soltechnology.dev/avroconvert/</PackageProjectUrl>
		<RepositoryType>Dependency</RepositoryType>
		<PackageTags>avro communication event bus confluent apache kafka core microservice apache.avro</PackageTags>
		<PackageId>SolTechnology.Avro.Kafka</PackageId>
		<RepositoryUrl>https://github.com/AdrianStrugala/AvroConvert</RepositoryUrl>
		<AssemblyName>SolTechnology.Avro.Kafka</AssemblyName>
		<RootNamespace>SolTechnology.Avro.Kafka</RootNamespace>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>avroconvert-icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
		<None Include="..\..\docs\avroconvert-icon.png" Pack="true" Visible="false" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Confluent.Kafka" />
		<PackageReference Include="Confluent.SchemaRegistry" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AvroConvert\AvroConvert.csproj" />
	</ItemGroup>

</Project>

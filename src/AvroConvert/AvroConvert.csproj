<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<Authors>Adrian Strugala</Authors>
		<Company>SolTechnology</Company>
		<Version>4.0.0-preview.1</Version>
		<Description>Rapid Apache Avro serializer for .NET. Free for noncommercial use and for companies under 100 people / 1M USD revenue (PolyForm Noncommercial / Small Business); commercial licence for other organisations – see LICENSE.md.</Description>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReleaseNotes>4.0: new licence (PolyForm Noncommercial / Small Business / Commercial), net10.0 only, compiled typed serializers (up to 20x faster deserialization), spec fixes. See docs/CHANGELOG.md.</PackageReleaseNotes>
		<PackageProjectUrl>https://soltechnology.dev/avroconvert/</PackageProjectUrl>
		<RepositoryType>Dependency</RepositoryType>
		<PackageTags>avro serialization deserialization standard apache core microservice big data bigdata kafka apache.avro</PackageTags>
		<ApplicationIcon />
		<StartupObject />
		<Product>AvroConvert</Product>
		<PackageId>AvroConvert</PackageId>
		<RepositoryUrl>https://github.com/AdrianStrugala/AvroConvert</RepositoryUrl>
		<AssemblyName>SolTechnology.Avro</AssemblyName>
		<RootNamespace>SolTechnology.Avro</RootNamespace>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>AvroConvertUnitTests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>CoreBenchmarks</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>


	<PropertyGroup>
		<PackageIcon>avroconvert-icon.png</PackageIcon>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
		<None Include="..\..\licenses\PolyForm-Noncommercial-1.0.0.md" Pack="true" PackagePath="licenses\" />
		<None Include="..\..\licenses\PolyForm-Small-Business-1.0.0.md" Pack="true" PackagePath="licenses\" />
		<None Include="..\..\licenses\Commercial.md" Pack="true" PackagePath="licenses\" />
		<None Include="NOTICE" Pack="true" PackagePath="\" />
		<None Include="..\..\docs\avroconvert-icon.png" Pack="true" Visible="false" PackagePath="\" />
	</ItemGroup>


	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.*" />
		<PackageReference Include="IronSnappy" Version="1.3.*" />
	</ItemGroup>


	<!-- To indlucde referenced projects in nuget package: -->
	<PropertyGroup>
		<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
	</PropertyGroup>
	<Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
		<ItemGroup>
			<BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
		</ItemGroup>
	</Target>

</Project>